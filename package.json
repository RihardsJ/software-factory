{
  "name": "software-factory",
  "version": "0.1.0",
  "private": true,
  "description": "A learning project for building reliable Three.js web applications.",
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "lint": "nx run-many -t lint --outputStyle=static",
    "typecheck": "nx run-many -t typecheck --outputStyle=static",
    "test": "nx run-many -t test --outputStyle=static",
    "test:watch": "npm run test:watch --workspace=@software-factory/factory",
    "build": "nx run-many -t build --outputStyle=static",
    "check": "nx run-many -t lint typecheck test build e2e --outputStyle=static",
    "nx": "nx",
    "specify": "uvx --from git+https://github.com/github/spec-kit.git@v1.4.0 specify",
    "dev": "nx run reference:dev",
    "e2e": "nx run reference:e2e --outputStyle=static",
    "browsers:install": "playwright install chromium"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nx/devkit": "24.0.6",
    "@nx/eslint": "24.0.6",
    "@nx/eslint-plugin": "24.0.6",
    "@nx/js": "24.0.6",
    "@nx/playwright": "24.0.6",
    "@nx/vite": "24.0.6",
    "@nx/vitest": "24.0.6",
    "@nx/web": "24.0.6",
    "@playwright/test": "1.65.0",
    "@swc/core": "1.15.47",
    "@swc/helpers": "0.5.24",
    "@types/node": "24.19.2",
    "@types/three": "0.187.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "eslint-plugin-playwright": "1.8.3",
    "jiti": "2.4.2",
    "jsdom": "27.4.0",
    "nx": "24.0.6",
    "swc-loader": "0.1.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "workspaces": [
    "apps/*",
    "libs/*",
    "tools/*"
  ],
  "nx": {
    "includedScripts": [],
    "targets": {
      "lint": {
        "command": "eslint eslint.config.mjs --max-warnings=0"
      },
      "typecheck": {
        "command": "tsc -p tsconfig.json --noEmit"
      }
    }
  },
  "dependencies": {
    "tslib": "2.9.1"
  },
  "volta": {
    "node": "24.13.0",
    "npm": "11.6.2"
  }
}
