#!/usr/bin/env bash
set -euo pipefail

# Resolved through the symlink that puts this command on PATH.
self="$(readlink -f "${BASH_SOURCE[0]}")"
factory_home="$(cd "$(dirname "$self")/.." && pwd)"
template="${FACTORY_TEMPLATE:-https://github.com/RihardsJ/ts-project-template.git}"

# The number is set by hand in VERSION; the commit tells two builds of one number apart.
version() {
  local number commit
  number="$(cat "$factory_home/VERSION" 2>/dev/null || echo unknown)"
  commit="$(git -C "$factory_home" rev-parse --short HEAD 2>/dev/null || true)"
  echo "$number${commit:+ ($commit)}"
}

# A project carries its own copy of the factory. Keep it in step with the
# command, so 'factory update' alone is enough to get new behaviour.
sync_project() {
  local installed current
  installed="$(sed -n 's/^version=//p' factory/.installed 2>/dev/null || true)"
  current="$(version)"
  [ "$installed" != "$current" ] || return 0
  if [ -n "${FACTORY_PIN:-}" ]; then
    echo "factory: this project has $installed and the command is $current. FACTORY_PIN is set, so it is left as it is." >&2
    return 0
  fi
  "$factory_home/install.sh" . > /dev/null
  if git rev-parse --git-dir > /dev/null 2>&1; then
    git add --all -- factory CLAUDE.md
    git diff --cached --quiet -- factory CLAUDE.md \
      || git commit --quiet --message "Update factory to $current" -- factory CLAUDE.md
  fi
  echo "Updated the factory in this project: ${installed:-none} -> $current"
}

fail() {
  echo "factory: $1" >&2
  exit 1
}

usage() {
  echo "factory $(version)"
  echo
  cat <<'EOF'
Usage:
  factory new <name>      Create ./<name> from the project template and install the factory in it
  factory install [dir]   Install or update the factory in an existing project (default: current directory)
  factory run <text>      In a project: idea, plan and build in one go, headless
  factory idea <text>     In a project: refine a sentence into specs/idea.md, for you to check
  factory plan            In a project: idea -> stories -> tickets; asks you only if questions remain
  factory build [n]       In a project: the Ralph loop. One ticket per fresh run until none are left (at most n, default 25)
  factory status          In a project: where it stands and what is running (--watch to follow)
  factory stop            In a project: stop the run in progress, and the agent it started
  factory update          Pull the latest factory
  factory -v              Show the version
EOF
}

new_project() {
  local name="${1:-}"
  [ -n "$name" ] || fail "give the project a name: factory new <name>"
  case "$name" in
    .*|*[!A-Za-z0-9._-]*) fail "use only letters, digits, dots, dashes and underscores in the name." ;;
  esac
  [ ! -e "$name" ] || fail "$name already exists here."

  git clone --quiet --depth 1 "$template" "$name"
  rm -rf "$name/.git"

  # The template's own name would otherwise follow every project made from it.
  for file in package.json package-lock.json; do
    [ ! -f "$name/$file" ] || sed -i.bak "s/\"name\": \"ts-project-template\"/\"name\": \"$name\"/" "$name/$file"
    rm -f "$name/$file.bak"
  done

  git -C "$name" init --quiet --initial-branch=main
  "$factory_home/install.sh" "$name"

  git -C "$name" add --all
  git -C "$name" commit --quiet --message "Start $name from the project template with the factory installed" \
    || echo "factory: files are staged but not committed; set git user.name and user.email, then commit." >&2

  # Setup belongs to the template, since only it knows its own toolchain.
  if [ -x "$name/setup.sh" ]; then
    echo "Created $name. Running its setup script..."
    "$name/setup.sh" || fail "$name was created, but its setup script failed. Fix the cause, then run ./setup.sh in $name."
    echo "$name is ready. Next: cd $name"
  else
    echo "Created $name. It has no setup.sh, so follow its README to install dependencies. Next: cd $name"
  fi
}

case "${1:-}" in
  new) new_project "${2:-}" ;;
  install) "$factory_home/install.sh" "${2:-.}" ;;
  update)
    git -C "$factory_home" pull --ff-only
    echo "factory $(version)"
    ;;
  -v|--version|version) echo "factory $(version)" ;;
  idea|plan|build|status|stop)
    [ -x "factory/plan.sh" ] || fail "no factory here. Run this from a project root after 'factory install'."
    sync_project
    command="$1"
    shift
    exec "factory/$command.sh" "$@"
    ;;
  run)
    [ -x "factory/plan.sh" ] || fail "no factory here. Run this from a project root after 'factory install'."
    sync_project
    shift
    # One command, start to finish. Each step stops the run if its gate fails.
    if [ $# -gt 0 ] || [ ! -s specs/idea.md ]; then
      factory/idea.sh "$@"
      git add --all -- specs && { git diff --cached --quiet -- specs || git commit --quiet --message "factory: idea" -- specs; }
    fi
    factory/plan.sh
    if grep -q '^Verdict: pass$' tickets/review.md 2>/dev/null; then
      exec factory/build.sh
    fi
    echo "Planning stopped before the tickets were ready, so nothing was built. See above."
    ;;
  -h|--help|help|'') usage ;;
  *) usage >&2; exit 1 ;;
esac
